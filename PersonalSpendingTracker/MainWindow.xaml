<Window x:Class="PersonalSpendingTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Előfizetés-követő" Height="460" Width="540"
        Background="#F5F6FA" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="10">

        <TabItem Header="Havi előfizetések">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Név" Foreground="#6B7280" Margin="0,0,0,2"/>
                        <TextBox x:Name="tbMonthlyName" Width="200"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Ár (Ft)" Foreground="#6B7280" Margin="0,0,0,2"/>
                        <TextBox x:Name="tbMonthlyPrice" Width="90"/>
                    </StackPanel>
                    <Button Content="Hozzáadás" Click="AddMonthly_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Törlés" Click="DeleteMonthly_Click" Background="#EF4444"
                            Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>

                <DataGrid x:Name="dgMonthly" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Ár / hó" Binding="{Binding Price, StringFormat='{}{0:N0} Ft'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Éves előfizetések">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Név" Foreground="#6B7280" Margin="0,0,0,2"/>
                        <TextBox x:Name="tbYearlyName" Width="200"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Ár (Ft)" Foreground="#6B7280" Margin="0,0,0,2"/>
                        <TextBox x:Name="tbYearlyPrice" Width="90"/>
                    </StackPanel>
                    <Button Content="Hozzáadás" Click="AddYearly_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Törlés" Click="DeleteYearly_Click" Background="#EF4444"
                            Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>

                <DataGrid x:Name="dgYearly" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Ár / év" Binding="{Binding Price, StringFormat='{}{0:N0} Ft'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Összesítés">
            <StackPanel Margin="20">
                <TextBlock x:Name="tbMonthlyTotal" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="tbYearlyTotal" FontSize="14" Margin="0,0,0,16"/>
                <TextBlock x:Name="tbPerYear" FontSize="22" FontWeight="Bold"
                           Foreground="#1D4ED8" Margin="0,0,0,6"/>
                <TextBlock x:Name="tbPerMonth" FontSize="14" Foreground="#6B7280"/>
            </StackPanel>
        </TabItem>

    </TabControl>
</Window>